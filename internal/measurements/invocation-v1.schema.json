{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runner.dev/contracts/validator-invocation-v1",
  "title": "Runner transcription of Validator v1 invocation rules from pinned validation.ts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "revision",
    "measurement_schema_version",
    "session_id",
    "invocation_id",
    "lifecycle",
    "diagnostics",
    "attempt_ids",
    "zero_dispatch"
  ],
  "properties": {
    "record_type": {
      "const": "invocation"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "measurement_schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "consumer_context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "consumer",
        "context_id"
      ],
      "properties": {
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "zero_dispatch": {
      "type": "boolean"
    },
    "command": {
      "enum": [
        "run",
        "check",
        "review"
      ]
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "reason"
      ],
      "properties": {
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stringEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "value",
            "reason"
          ],
          "properties": {
            "availability": {
              "const": "available"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "value",
            "reason"
          ],
          "properties": {
            "availability": {
              "const": "unavailable"
            },
            "value": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "started_at",
        "ended_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "running",
            "completed",
            "failed",
            "interrupted"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "model",
        "provider",
        "effort",
        "provenance"
      ],
      "properties": {
        "adapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "enum": [
            "configuration",
            "launch_resolution",
            "telemetry"
          ]
        }
      }
    },
    "observedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_id",
        "model",
        "provider",
        "effort",
        "provenance"
      ],
      "properties": {
        "identity_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "$ref": "#/$defs/stringEvidence"
        },
        "effort": {
          "$ref": "#/$defs/stringEvidence"
        },
        "provenance": {
          "const": "telemetry"
        }
      }
    },
    "measurement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "value",
            "reason",
            "source",
            "origin",
            "precision",
            "derivation",
            "included_in"
          ],
          "properties": {
            "availability": {
              "const": "available"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reason": {
              "type": "null"
            },
            "source": {
              "enum": [
                "provider_usage",
                "provider_display",
                "provider_event",
                "validator_derivation"
              ]
            },
            "origin": {
              "enum": [
                "observed",
                "derived"
              ]
            },
            "precision": {
              "enum": [
                "exact",
                "approximate"
              ]
            },
            "derivation": {
              "type": [
                "string",
                "null"
              ]
            },
            "included_in": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "value",
            "reason",
            "source",
            "origin",
            "precision",
            "derivation",
            "included_in"
          ],
          "properties": {
            "availability": {
              "const": "partial"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "provider_usage",
                "provider_display",
                "provider_event",
                "validator_derivation"
              ]
            },
            "origin": {
              "enum": [
                "observed",
                "derived"
              ]
            },
            "precision": {
              "enum": [
                "exact",
                "approximate"
              ]
            },
            "derivation": {
              "type": [
                "string",
                "null"
              ]
            },
            "included_in": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "value",
            "reason",
            "source",
            "origin",
            "precision",
            "derivation",
            "included_in"
          ],
          "properties": {
            "availability": {
              "const": "unavailable"
            },
            "value": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "null"
            },
            "origin": {
              "type": "null"
            },
            "precision": {
              "type": "null"
            },
            "derivation": {
              "type": "null"
            },
            "included_in": {
              "type": "null"
            }
          }
        }
      ]
    },
    "decimalMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "value",
        "reason",
        "source",
        "origin",
        "precision",
        "derivation",
        "included_in"
      ],
      "properties": {
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "enum": [
            "provider_usage",
            "provider_display",
            "provider_event",
            "validator_derivation",
            null
          ]
        },
        "origin": {
          "enum": [
            "observed",
            "derived",
            null
          ]
        },
        "precision": {
          "enum": [
            "exact",
            "approximate",
            null
          ]
        },
        "derivation": {
          "type": [
            "string",
            "null"
          ]
        },
        "included_in": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_total",
        "input_uncached",
        "cache_read",
        "cache_write",
        "output",
        "reasoning",
        "provider_total",
        "normalized_total"
      ],
      "properties": {
        "input_total": {
          "$ref": "#/$defs/measurement"
        },
        "input_uncached": {
          "$ref": "#/$defs/measurement"
        },
        "cache_read": {
          "$ref": "#/$defs/measurement"
        },
        "cache_write": {
          "$ref": "#/$defs/measurement"
        },
        "output": {
          "$ref": "#/$defs/measurement"
        },
        "reasoning": {
          "$ref": "#/$defs/measurement"
        },
        "provider_total": {
          "$ref": "#/$defs/measurement"
        },
        "normalized_total": {
          "$ref": "#/$defs/measurement"
        }
      }
    },
    "nativeUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "name",
        "value"
      ],
      "properties": {
        "source": {
          "enum": [
            "provider_usage",
            "provider_display",
            "provider_event",
            "validator_derivation"
          ]
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history",
        "collection",
        "canonical_fields",
        "normalized_total",
        "per_model_attribution"
      ],
      "properties": {
        "history": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "collection": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "canonical_fields": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "normalized_total": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "per_model_attribution": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_total"
      ],
      "properties": {
        "normalized_total": {
          "$ref": "#/$defs/measurement"
        }
      }
    },
    "unavailableIdentityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "reason"
      ],
      "properties": {
        "availability": {
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_id",
        "observed_identity_ref",
        "usage"
      ],
      "properties": {
        "allocation_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_identity_ref": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "$ref": "#/$defs/usage"
        }
      }
    },
    "unallocated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_id",
        "observed_identity_ref",
        "usage"
      ],
      "properties": {
        "allocation_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_identity_ref": {
          "$ref": "#/$defs/unavailableIdentityReference"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_evidence_id",
        "amount",
        "currency",
        "scope",
        "coverage",
        "overlap",
        "source"
      ],
      "properties": {
        "cost_evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "$ref": "#/$defs/decimalMeasurement"
        },
        "currency": {
          "$ref": "#/$defs/stringEvidence"
        },
        "scope": {
          "enum": [
            "attempt",
            "allocation",
            "unavailable"
          ]
        },
        "allocation_id": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "enum": [
            "full",
            "partial",
            "unknown"
          ]
        },
        "overlap": {
          "enum": [
            "established",
            "unknown"
          ]
        },
        "source": {
          "enum": [
            "provider_usage",
            "provider_display",
            "provider_event",
            "validator_derivation"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_version",
        "build",
        "adapter_mapping_version",
        "cli_version",
        "source_format_version"
      ],
      "properties": {
        "producer_version": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "$ref": "#/$defs/stringEvidence"
        },
        "adapter_mapping_version": {
          "type": "string",
          "minLength": 1
        },
        "cli_version": {
          "$ref": "#/$defs/stringEvidence"
        },
        "source_format_version": {
          "$ref": "#/$defs/stringEvidence"
        }
      }
    }
  }
}
