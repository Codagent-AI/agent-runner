# Test that shell step capture + interpolation works.
exec agent-runner .agent-runner/workflows/workflow-v1.0.yaml
stdout 'captured:hello'

-- .agent-runner/workflows/workflow-v1.0.yaml --
name: workflow
steps:
  - id: capture-step
    command: echo hello
    capture: output
  - id: use-capture
    command: echo captured:{{output}}
