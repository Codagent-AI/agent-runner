# Resume keeps the recorded root after the mapping changes.
env PATH=$WORK/bin:$PATH
env LOG=$WORK/openspec.log
chmod 755 bin/openspec
chmod 755 bin/agent-validator
chmod 755 bin/claude
mkdir a/openspec b/openspec
exec git init -b main code
exec git -C code config user.name Test
exec git -C code config user.email test@example.com
exec git -C code commit --allow-empty -m initial
exec sh -c 'printf "openspec_roots:\n  %s/code: %s/a\n" "$PWD" "$PWD" > .agent-runner/settings.yaml'
cd code
! exec agent-runner run openspec:change change_name=foo
stdout 'validate-feature-branch.*failed|step.*failed'
exec git checkout -b feature
exec sh -c 'printf "openspec_roots:\n  %s/code: %s/b\n" "$HOME" "$HOME" > "$HOME/.agent-runner/settings.yaml"'
! exec sh -c 'agent-runner -resume "$(ls -d "$HOME"/.agent-runner/projects/*/runs/*/ | head -1 | xargs basename)"'
exists $WORK/a/openspec/changes/foo
! exists $WORK/b/openspec/changes/foo
! exists openspec
exec cat $WORK/openspec.log
stdout '/a new change foo'
! stdout '/b new change foo'

-- bin/openspec --
#!/bin/sh
set -eu
printf '%s %s\n' "$PWD" "$*" >> "$LOG"
if [ "$1" = new ]; then mkdir -p "openspec/changes/$3"; fi
-- bin/agent-validator --
#!/bin/sh
exit 2
-- bin/claude --
#!/bin/sh
exit 1
-- .agent-runner/settings.yaml --
{}
-- .agent-runner/config.yaml --
profiles:
  default:
    agents:
      lead: {cli: claude, default_mode: autonomous}
      implementor: {cli: claude, default_mode: autonomous}
      crosscheck: {cli: claude, default_mode: autonomous}
      tester: {cli: claude, default_mode: autonomous}
