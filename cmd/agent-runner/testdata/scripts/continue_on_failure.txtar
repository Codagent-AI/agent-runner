# Test that continue_on_failure allows the workflow to proceed past a failed step.
exec agent-runner .agent-runner/workflows/workflow-v1.0.yaml
stdout ok

-- .agent-runner/workflows/workflow-v1.0.yaml --
name: workflow
steps:
  - id: failing-step
    command: "false"
    continue_on_failure: true
  - id: next-step
    command: echo ok
